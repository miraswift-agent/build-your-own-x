// Stage 56 example: array-union.lox
// Multiset union: for each value v, the result has
// v count = max(count_in_arr1, count_in_arr2). Order
// of first appearance in arr1 is preserved, then
// first appearance in arr2 of values not yet in
// result. Neither input is mutated.
//
// The shape: 2 args (array, array). Returns a new
// array. The new wrinkle: the fourth 2-source native
// (after zip, zip_longest, intersect). Like Stage 55
// it uses the "remaining copy" pattern — but the fill
// direction is different (one walks, one drains).

print "=== array_union basic ===";
// arr1 = [1, 2, 3] (1: 1, 2: 1, 3: 1)
// arr2 = [3, 4, 5] (3: 1, 4: 1, 5: 1)
// max for each: 1, 1, 1, 1, 1
// Result: [1, 2, 3, 4, 5] (arr1 first, then arr2's
// new values in arr2 order)
var r = array_union([1, 2, 3], [3, 4, 5]);
for (var i = 0; i < array_length(r); i = i + 1) {
    print string(array_get(r, i));
}
// Output:
//   1
//   2
//   3
//   4
//   5

print "=== array_union multiset (the defining test) ===";
// arr1 = [1, 1, 2] (1: 2, 2: 1)
// arr2 = [1, 2, 2] (1: 1, 2: 2)
// max(2, 1) = 2 for 1; max(1, 2) = 2 for 2
// Result: [1, 1, 2, 2] — 2 copies of each, NOT [1, 2]
// (multiset, not unique). A pure-set union would give
// [1, 2]; a sum-semantic union (count1+count2) would
// give [1, 1, 1, 2, 2, 2]. We chose max(c1, c2) which
// matches Python's `Counter | Counter`.
var r2 = array_union([1, 1, 2], [1, 2, 2]);
for (var i = 0; i < array_length(r2); i = i + 1) {
    print string(array_get(r2, i));
}
// Output:
//   1
//   1
//   2
//   2

print "=== array_union arr1 dominates ===";
// arr1 has more of a value than arr2: result count
// is arr1's count.
var r3 = array_union([1, 1, 1, 1], [1, 2]);
for (var i = 0; i < array_length(r3); i = i + 1) {
    print string(array_get(r3, i));
}
// Output:
//   1
//   1
//   1
//   1
//   2

print "=== array_union arr2 dominates ===";
// arr2 has more of a value than arr1: result count
// is arr2's count. The extras from arr2 come AFTER
// arr1's first-occurrence walk.
var r4 = array_union([1, 2], [1, 1, 1, 1]);
for (var i = 0; i < array_length(r4); i = i + 1) {
    print string(array_get(r4, i));
}
// Output:
//   1
//   2
//   1
//   1
//   1

print "=== array_union full overlap ===";
// arr1 == arr2: result is a copy of arr1 (max(1, 1) = 1).
var r5 = array_union([1, 2, 3], [1, 2, 3]);
for (var i = 0; i < array_length(r5); i = i + 1) {
    print string(array_get(r5, i));
}
// Output:
//   1
//   2
//   3

print "=== array_union no overlap ===";
// No shared values: result is concatenation
// of arr1 then arr2.
var r6 = array_union([1, 2], [3, 4]);
for (var i = 0; i < array_length(r6); i = i + 1) {
    print string(array_get(r6, i));
}
// Output:
//   1
//   2
//   3
//   4

print "=== array_union empty inputs ===";
// Empty + anything: the non-empty one. Two empties: empty.
var r7a = array_union([], [1, 2, 3]);
var r7b = array_union([1, 2, 3], []);
var r7c = array_union([], []);
print "empty-arr1:";
for (var i = 0; i < array_length(r7a); i = i + 1) {
    print string(array_get(r7a, i));
}
print "empty-arr2:";
for (var i = 0; i < array_length(r7b); i = i + 1) {
    print string(array_get(r7b, i));
}
print "both-empty:" + string(array_length(r7c));
// Output:
//   empty-arr1:
//   1
//   2
//   3
//   empty-arr2:
//   1
//   2
//   3
//   both-empty:0

print "=== array_union does not mutate ===";
// Neither input is mutated. (Confirmed by checking
// lengths and key elements after the call.)
var a1 = [1, 1, 2];
var a2 = [1, 2, 2];
var r8 = array_union(a1, a2);
print "a1.len:" + string(array_length(a1));
print "a1.0:" + string(array_get(a1, 0));
print "a1.1:" + string(array_get(a1, 1));
print "a1.2:" + string(array_get(a1, 2));
print "a2.len:" + string(array_length(a2));
print "a2.0:" + string(array_get(a2, 0));
print "a2.1:" + string(array_get(a2, 1));
print "a2.2:" + string(array_get(a2, 2));
print "r8.len:" + string(array_length(r8));
// Output:
//   a1.len:3
//   a1.0:1
//   a1.1:1
//   a1.2:2
//   a2.len:3
//   a2.0:1
//   a2.1:2
//   a2.2:2
//   r8.len:4

print "=== array_union strings ===";
// Value comparison uses clox's valuesEqual() (same
// as Stage 40's array_unique_by). Strings compare
// by content. arr1 = [apple, banana], arr2 = [apple,
// cherry, date]. Result: [apple, banana, cherry, date]
// (apple already in result from arr1; banana not in
// arr2; cherry, date come from arr2 in order).
var r9 = array_union(["apple", "banana"], ["apple", "cherry", "date"]);
for (var i = 0; i < array_length(r9); i = i + 1) {
    print array_get(r9, i);
}
// Output:
//   apple
//   banana
//   cherry
//   date

print "=== array_union (use case: combined tag set) ===";
// A real use case: combine the tags of two articles
// into a single set with multiset counts (= "how many
// times does this tag appear across both articles,
// up to the max").
var article1_tags = ["python", "vm", "compiler"];
var article2_tags = ["python", "parser", "compiler"];
var combined = array_union(article1_tags, article2_tags);
// python: max(1, 1) = 1
// vm: max(1, 0) = 1
// compiler: max(1, 1) = 1
// parser: max(0, 1) = 1
// Result: [python, vm, compiler, parser]
print "combined.len:" + string(array_length(combined));
for (var i = 0; i < array_length(combined); i = i + 1) {
    print array_get(combined, i);
}
// Output:
//   combined.len:4
//   python
//   vm
//   compiler
//   parser

// --- What this stage teaches ---
//
// (a) "Multiset vs unique vs sum — the
//     defining design choice for
//     array_union." Three reasonable
//     semantics:
//       (i)   max(c1, c2) (Python Counter |
//             Counter) — chosen
//       (ii)  c1 + c2 (Python Counter +
//             Counter) — sum of all values
//       (iii) 1 if v in either, 0
//             otherwise (Python set | set)
//             — unique union
//     The choice was Tom-callable; I went
//     with (i) because it matches the
//     mathematical multiset-union standard.
//     The wiki's pick for Stage 56
//     contained an ambiguous spec
//     ("count = count1 + count2" vs
//     "deduplicated by min-count"). I
//     chose `max(count1, count2)` and
//     documented the alternatives in the
//     close-out. If Tom prefers (ii) or
//     (iii), the impl is a 1- to 10-line
//     change.
//
// (b) "13th-consec-zero-bug stage" —
//     Stage 56 continues the streak from
//     Stage 44 (1) through Stage 55 (12).
//     0 impl bugs, 0 test bugs in Stage 56.
//     3 short of the 16-streak record, 4
//     short of the 17-streak record. The
//     next 3 stages (57-59) are the
//     closing-in period; if all 3 land
//     clean, the 16-streak is tied at
//     Stage 59, and Stage 60 is the
//     tie-breaker.
//
// (c) "Stage 44 push/pop lesson applied
//     for the 13th consecutive stage" —
//     the registration has 1 push + 1 pop
//     (balanced), the function body has 2
//     pushes (remaining + result) and 2
//     pops after the loop. The pattern is
//     "allocate working data on the Lox
//     heap for free GC protection." Same
//     as Stage 55's array_intersect.
//
// (d) "2-array-iteration flavor: walks
//     then drains" — Stage 55
//     (intersect) walks both, decrements
//     remaining, skips unmatched arr1
//     elements. Stage 56 (union) walks
//     arr1, decrements remaining, and
//     ALSO appends every arr1 element.
//     Then drains whatever's left in
//     remaining. The shapes are similar
//     (both are "remaining copy" patterns)
//     but the fill direction is
//     different. The discipline: **for
//     set operations, the
//     walking-strategy depends on whether
//     the op is intersection (skip) or
//     union/difference (append).**
//
// (e) "Set operations family is now 2
//     deep" — Stage 55 ships
//     array_intersect, Stage 56 ships
//     array_union. The natural follow-up
//     is array_difference (multiset
//     subtraction: count = max(0, c1 -
//     c2)). After Stage 56 ships, the
//     family is 2 of 3; array_difference
//     is the third.
//
// (f) "The order-preservation
//     discipline" — when a native
//     returns a multiset-aware result,
//     the order of the FIRST input is
//     preserved. arr2's new values come
//     AFTER arr1 in their arr2 order.
//     This matches Python's Counter |
//     Counter (the LHS defines the order
//     of the LHS values; the RHS values
//     appear after, in their RHS order).
//     The discipline: **define order in
//     terms of the first input, then the
//     second input's "new" values in
//     their natural order.** This makes
//     the operation non-symmetric
//     (`union(a, b) != union(b, a)` in
//     general), which is a feature not a
//     bug.
