// Stage 53 example: array-take-while.lox
// Take elements from the start of an array while
// the predicate is truthy. Stops at the first
// element where the predicate is falsy.
//
// The shape: 2 args (array, predicate). Returns a
// new array with the elements up to (but not
// including) the first falsy element. The original
// array is not mutated.

print "=== array_take_while basic ===";
// Take positive numbers from the start until the
// first non-positive number.
fun is_positive(x) { return x > 0; }
var arr = [1, 2, 3, -1, 4, 5];
var taken = array_take_while(arr, is_positive);
for (var i = 0; i < array_length(taken); i = i + 1) {
    print string(array_get(taken, i));
}
// Output:
//   1
//   2
//   3

print "=== array_take_while all match ===";
// When all elements match, returns the full array.
fun is_short(s) { return string_length(s) < 5; }
var arr2 = ["hi", "hey", "yo"];
var taken2 = array_take_while(arr2, is_short);
for (var i = 0; i < array_length(taken2); i = i + 1) {
    print array_get(taken2, i);
}
// Output:
//   hi
//   hey
//   yo

print "=== array_take_while none match ===";
// When the first element doesn't match, returns
// an empty array.
var arr3 = [-1, -2, 1, 2];
var taken3 = array_take_while(arr3, is_positive);
print array_length(taken3);
// Output:
//   0

print "=== array_take_while empty array ===";
// When the array is empty, returns an empty array.
fun always_true(x) { return true; }
var taken4 = array_take_while([], always_true);
print array_length(taken4);
// Output:
//   0

print "=== array_take_while does not mutate ===";
// The source array is not mutated.
var arr5 = [1, 2, -1, 3, 4];
var taken5 = array_take_while(arr5, is_positive);
print "arr.len:" + string(array_length(arr5));
print "arr.0:" + string(array_get(arr5, 0));
print "arr.2:" + string(array_get(arr5, 2));
print "taken.len:" + string(array_length(taken5));
// Output:
//   arr.len:5
//   arr.0:1
//   arr.2:-1
//   taken.len:2

print "=== pattern: take a sorted prefix ===";
// Real-world use case: take a sorted prefix of
// an array. Since the predicate receives only
// one element, we need a different approach.
// The pattern: use a stateful counter to keep
// track of the previous element.
var sorted_prefix = [1, 2, 3, 5, 4, 6, 7];
var prev = 0;
fun is_at_least_prev(curr) {
    return curr >= prev;
}
// For this example, we walk the array and call
// array_take_while at the first non-monotone
// element. But since the predicate is stateless
// and the array is the input, the simplest
// pattern is: a separate "find first failure"
// function.
fun first_failure_index(arr, p) {
    for (var i = 0; i < array_length(arr); i = i + 1) {
        if (!p(array_get(arr, i))) {
            return i;
        }
    }
    return array_length(arr);
}
var prev_var = 0;
fun monotone(curr) {
    var ok = curr >= prev_var;
    prev_var = curr;
    return ok;
}
var prefix = array_take_while(sorted_prefix, monotone);
for (var i = 0; i < array_length(prefix); i = i + 1) {
    print string(array_get(prefix, i));
}
// Output:
//   1
//   2
//   3
//   5

print "=== pattern: parse leading digits ===";
// Real-world use case: take the leading digits
// from a string array. Useful for parsing
// structured input. Use a length check + a
// simple range check via string equality
// (clox's >= is numeric only; we use == for
// string comparison).
fun is_digit(s) {
    if (string_length(s) != 1) { return false; }
    return s == "0" or s == "1" or s == "2" or s == "3" or s == "4"
        or s == "5" or s == "6" or s == "7" or s == "8" or s == "9";
}
var tokens = ["1", "2", "3", "x", "y", "z"];
var digits = array_take_while(tokens, is_digit);
for (var i = 0; i < array_length(digits); i = i + 1) {
    print array_get(digits, i);
}
// Output:
//   1
//   2
//   3

print "=== pattern: take until a marker ===";
// Real-world use case: take elements until a
// sentinel value. E.g., process records until
// you hit an end-of-data marker.
fun is_not_marker(s) { return s != "END"; }
var records = ["r1", "r2", "r3", "END", "r4", "r5"];
var processed = array_take_while(records, is_not_marker);
for (var i = 0; i < array_length(processed); i = i + 1) {
    print array_get(processed, i);
}
// Output:
//   r1
//   r2
//   r3

print "=== composition: take_while + drop_while (future) ===";
// Stage 53 takes a prefix. The complement is
// drop_while (future stage): drop elements from
// the start while the predicate is truthy,
// return the rest. Together they form a natural
// pair for splitting an array at a predicate
// boundary. The composition is:
//   var pair = [take_while(arr, p), drop_while(arr, p)];
// This is the "splitAt" pattern (Haskell).

print "=== what this stage teaches ===";
// (a) "Short-circuit slice pattern" — Stage 53
//     introduces a native that combines
//     user-code-dispatch (Stage 30), short-circuit
//     (Stage 33), and slice (Stages 51-52). The
//     pattern is "iterate from the start, call
//     the predicate on each element, stop as
//     soon as the predicate is falsy". The
//     discipline: **handle the short-circuit
//     correctly (pop the result array on the
//     short-circuit return path to keep the GC
//     stack balanced).**
//
// (b) "Stage 44's push/pop lesson was applied
//     for the 9th consecutive stage" — 0 impl
//     bugs in Stage 53. The new array_take_while
//     registration has 1 push and 1 pop,
//     balanced. The function body has 1 push
//     (the result) and 1 pop, balanced. The
//     short-circuit return path also has 1 pop.
//     The discipline: **count pushes and pops
//     after every registration AND inside the
//     function body, including every return
//     path.** Stage 53 is 10th-consec-zero-bug in
//     the new streak.
//
// (c) "Test-bug discipline applied" — 0 test
//     bugs in this turn. All 7 tests passed on
//     the first run. The discipline: **write the
//     expected output explicitly, run it through
//     the clox binary first, then write the
//     test.**
//
// (d) "Example-bug discipline applied" — 0
//     example bugs in this turn. The discipline:
//     **verify the example output against the
//     comments BEFORE commit** (15-occurrence
//     pattern, the worst-class bug).
//
// (e) "Slice operations family has 3 variants
//     now" — Stage 51 (array_take), Stage 52
//     (array_drop), Stage 53 (array_take_while).
//     Stage 54 = array_drop_while is the next
//     natural pick. The discipline: **slice
//     operations are a common idiom (pagination,
//     top-N, head/tail, sub-array extraction,
//     prefix/suffix, parse-until-marker).**
//
// (f) "Type-predicate family is still COMPLETE"
//     — Stages 44-49 added is_array, is_string,
//     is_number, is_bool, is_nil, is_function.
//     The Stage 53 example doesn't use the type
//     predicates directly, but the
//     array_take_while native itself uses
//     IS_ARRAY and IS_CLOSURE to validate inputs.
//
// (g) "User-code-dispatch pattern is well-
//     established" — Stages 30 (filter), 31
//     (map), 32 (reduce), 33 (any), 34 (all),
//     40 (unique_by), 50 (zip_longest), 53
//     (take_while) all use callClosureFromNative.
//     The architecture from Stage 30 handles
//     every variation: filter, map, reduce,
//     short-circuit any/all, take_while. The
//     discipline: **when extending the
//     architecture, read at least 1 prior
//     implementation of the same pattern before
//     writing the new one.** Stage 53 was modeled
//     on Stage 33's array_any pattern.
