// Stage 40 example: array-unique-by.lox
// The "dedup by custom key" native. Takes an array
// and a 1-arg Lox closure (the keyFn: (element) -> key);
// returns a new array containing the first occurrence
// of each unique key, in the order of first-occurrence.
// The original array is not mutated.
//
// Canonical convention: "first-occurrence-of-each-key"
// (matches lodash's _.uniqBy, not Python's more_itertools
// behavior). The keyFn is called once per element.
//
// Architecture: reuses Stage 30's callClosureFromNative
// (argCount=1). No new architecture work.

print "=== basic: dedup by identity (same as array_unique) ===";
// When the keyFn is the identity (returns the element
// itself), array_unique_by reduces to array_unique.
// The result is the first occurrence of each unique
// value, in input order.
fun identity(x) { return x; }
var arr = [1, 2, 1, 3, 2, 4];
var result = array_unique_by(arr, identity);
print array_get(result, 0);
print array_get(result, 1);
print array_get(result, 2);
print array_get(result, 3);
print array_length(result);
// Output:
//   1
//   2
//   3
//   4
//   4

print "=== dedup by first-element key (nested arrays) ===";
// The "by custom key" pattern: deduplicate nested arrays
// by their first element. Each pair is [id, value]; we
// dedup by id. The first occurrence of each id wins,
// regardless of the value.
//
//   [[1, "a"], [2, "b"], [1, "c"], [3, "a"]]
// keys are 1, 2, 1, 3 -> first-occurrence-of-each-key
// -> [[1, "a"], [2, "b"], [3, "a"]]
//
// Note: the second pair with id=1 ([[1, "c"]]) is
// dropped because id=1 was already seen. The pair
// with id=3 ([[3, "a"]]) is kept even though it has
// the same value as the first pair, because its id
// is new.
fun byFirst(pair) { return array_get(pair, 0); }
var nested = [[1, "a"], [2, "b"], [1, "c"], [3, "a"]];
var deduped = array_unique_by(nested, byFirst);
print array_get(array_get(deduped, 0), 0);
print array_get(array_get(deduped, 0), 1);
print array_get(array_get(deduped, 1), 0);
print array_get(array_get(deduped, 1), 1);
print array_get(array_get(deduped, 2), 0);
print array_get(array_get(deduped, 2), 1);
print array_length(deduped);
// Output:
//   1
//   a
//   2
//   b
//   3
//   a
//   3

print "=== empty array: returns empty array, keyFn not called ===";
// The empty input case: no iterations, no keyFn calls,
// result is an empty array.
var empty = array_unique_by([], identity);
print array_length(empty);
// Output: 0

print "=== single-element array: returns [that element] ===";
// The single-element input case: one keyFn call, the
// element is kept (its key is trivially new).
var single = array_unique_by([42], identity);
print array_get(single, 0);
print array_length(single);
// Output:
//   42
//   1

print "=== does not mutate the source ===";
// array_unique_by returns a new array; the source is
// unchanged. This is the canonical "non-mutating"
// pattern (matches array_filter, array_map, array_flatten).
var src = [10, 20, 10, 30];
array_unique_by(src, identity);
print array_get(src, 0);
print array_get(src, 1);
print array_get(src, 2);
print array_get(src, 3);
print array_length(src);
// Output:
//   10
//   20
//   10
//   30
//   4

print "=== composes with array_filter, array_map, array_reduce ===";
// The hand-rolled-idiom pattern: filter -> unique_by ->
// map. This is a common data-cleaning pipeline.
//
// Step 1: keep only positive numbers
//   [1, -2, 3, -4, 5, 6] -> [1, 3, 5, 6]
// Step 2: dedup by first-element key (for nested arrays)
//   We don't have nested input here, so we use a different
//   pipeline: dedup by sign (positive vs negative) and
//   keep the first of each. To compute sign, we use a
//   ternary via a helper.
//   Actually, the simpler composition: dedup by modulo
//   using integer arithmetic via string_length. We just
//   compute the first digit of the absolute value as a
//   string, then dedup by that.
//
//   Simpler: dedup by (n > 0) — bools are values in clox.
//   [1, 3, 5, 6] -> keys [true, true, true, true] -> [1]
//   That collapses to one element. Not useful.
//
//   Use a more meaningful keyFn: a nested-array dedup.
//   [1, 3, 5, 6] doesn't help. Let's just demonstrate
//   the composition with a different pipeline:
//   filter -> map -> unique_by. (Order doesn't matter
//   for idempotence: the result is the same regardless
//   of order, as long as the keyFn is deterministic.)
//
//   Pipeline: square, then dedup by > 10.
//   [1, 3, 5, 6] -> [1, 9, 25, 36] -> dedup by (>10)
//   keys [false, false, true, true] -> [1, 25]
//   The first value with key false is 1; the first with
//   key true is 25.
fun isPositive(n) { return n > 0; }
fun isBig(n) { return n > 10; }
fun square(n) { return n * n; }
var pipeline = array_unique_by(
    array_map(
        array_filter([1, -2, 3, -4, 5, 6], isPositive),
        square),
    isBig);
print array_get(pipeline, 0);
print array_get(pipeline, 1);
print array_length(pipeline);
// Output:
//   1
//   25
//   2

print "=== what this stage teaches ===";
// (a) "Dedup by custom key" is a different category from
//     "dedup by value." Stage 28's array_unique uses
//     valuesEqual on the elements; Stage 40's
//     array_unique_by uses valuesEqual on the keyFn's
//     return values. The "by key" pattern is the natural
//     extension when elements aren't directly comparable
//     (e.g., nested arrays, objects in other languages).
//
// (b) "First-occurrence-of-each-key" is the canonical
//     convention. JS (lodash's _.uniqBy), Rust (itertools),
//     and most other languages agree. When the design
//     matches an existing canonical convention, document
//     the convention in the close-out, not in the test.
//
// (c) "Parallel seenKeys array on the Lox heap" is the
//     GC pattern for the "remember the keys we've seen"
//     bookkeeping. The alternative (a C-side Value array)
//     would need its own GC root; the Lox heap gives us
//     push/pop GC protection for free.
//
// (d) "Reuse callClosureFromNative" is the discipline for
//     any new high-order native. The architecture from
//     Stage 30 is now used by 8 natives (filter, map,
//     reduce, any, all, find, find_index, unique_by).
//     The user-code-dispatch pattern is fully established.
