// reverse-lines.lox — read a file, reverse the order of its lines,
// write the result. Demonstrates: io_read_lines, io_write_lines,
// indexed access, array_push.

var input = "lines-input.txt";
var output = "lines-output.txt";

if (!io_file_exists(input)) {
    io_eprint("reverse-lines: missing " + input + "
");
    io_exit(1);
}

var lines = io_read_lines(input);
var n = array_length(lines);

var reversed = [];
var i = 0;
while (i < n) {
    array_push(reversed, lines[n - 1 - i]);
    i = i + 1;
}

io_write_lines(output, reversed);
print("Wrote lines in reverse order");
print(n);
