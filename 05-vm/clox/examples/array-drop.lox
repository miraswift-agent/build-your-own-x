// Stage 52 example: array-drop.lox
// Drop the first N elements of an array. The
// "skip the first N" pattern is the complement of
// Stage 51's array_take.
//
// The shape: 2 args (array, count). Returns a new
// array with the elements from index N to the end.
// If N >= array length, returns an empty array.
// If N <= 0, returns the full array. The original
// array is not mutated.

print "=== array_drop basic ===";
// Drop the first 2 elements of a 5-element array.
var arr = [1, 2, 3, 4, 5];
var dropped = array_drop(arr, 2);
for (var i = 0; i < array_length(dropped); i = i + 1) {
    print string(array_get(dropped, i));
}
// Output:
//   3
//   4
//   5

print "=== array_drop when N equals length ===";
// When N equals the array length, the result is
// an empty array.
var arr2 = [10, 20, 30];
var dropped2 = array_drop(arr2, 3);
print array_length(dropped2);
// Output:
//   0

print "=== array_drop when N exceeds length ===";
// When N > array length, the result is an empty
// array. (No error; just drops everything.)
var arr3 = [1, 2];
var dropped3 = array_drop(arr3, 10);
print array_length(dropped3);
// Output:
//   0

print "=== array_drop when N is 0 ===";
// When N is 0, the result is the full array.
var arr4 = [1, 2, 3];
var dropped4 = array_drop(arr4, 0);
for (var i = 0; i < array_length(dropped4); i = i + 1) {
    print string(array_get(dropped4, i));
}
// Output:
//   1
//   2
//   3

print "=== array_drop does not mutate ===";
// The source array is not mutated.
var arr5 = [1, 2, 3, 4, 5];
var dropped5 = array_drop(arr5, 3);
print "arr.len:" + string(array_length(arr5));
print "arr.0:" + string(array_get(arr5, 0));
print "arr.4:" + string(array_get(arr5, 4));
print "dropped.len:" + string(array_length(dropped5));
// Output:
//   arr.len:5
//   arr.0:1
//   arr.4:5
//   dropped.len:2

print "=== composition: array_take(array_drop(arr, n), m) ===";
// The canonical composition: take m elements
// starting at index n. This is the "sub-array"
// idiom. Equivalent to Python's arr[n:n+m].
var arr6 = [1, 2, 3, 4, 5];
var middle = array_take(array_drop(arr6, 1), 3);
for (var i = 0; i < array_length(middle); i = i + 1) {
    print string(array_get(middle, i));
}
// Output:
//   2
//   3
//   4

print "=== composition: split into head and tail ===";
// array_take and array_drop are complements: one
// takes from the start, the other drops from the
// start. They form a natural pair for splitting
// an array into head and tail (like LISP's car +
// cdr, or Haskell's splitAt).
fun split_at(arr, n) {
    var head = array_take(arr, n);
    var tail = array_drop(arr, n);
    return [head, tail];
}
var pair = split_at([1, 2, 3, 4, 5], 2);
var head = array_get(pair, 0);
var tail = array_get(pair, 1);
print "head:";
for (var i = 0; i < array_length(head); i = i + 1) {
    print string(array_get(head, i));
}
print "tail:";
for (var i = 0; i < array_length(tail); i = i + 1) {
    print string(array_get(tail, i));
}
// Output:
//   head:
//   1
//   2
//   tail:
//   3
//   4
//   5

print "=== pattern: pagination (now elegant) ===";
// Stage 51's pagination example was verbose
// (inlined the skip logic with a loop). With
// array_drop, pagination becomes elegant:
// array_take(array_drop(items, start), page_size).
fun page(items, page_size, page_num) {
    var start = (page_num - 1) * page_size;
    return array_take(array_drop(items, start), page_size);
}
var items = ["a", "b", "c", "d", "e", "f", "g", "h", "i"];
var page1 = page(items, 3, 1);
var page2 = page(items, 3, 2);
var page3 = page(items, 3, 3);
fun print_arr(arr) {
    for (var i = 0; i < array_length(arr); i = i + 1) {
        print array_get(arr, i);
    }
}
print_arr(page1);
print_arr(page2);
print_arr(page3);
// Output:
//   a
//   b
//   c
//   d
//   e
//   f
//   g
//   h
//   i

print "=== pattern: skip invalid prefix ===";
// Real-world use case: skip a leading sentinel
// value (e.g., a header row) before processing.
var rows = ["HEADER", "row1", "row2", "row3"];
var data = array_drop(rows, 1);
for (var i = 0; i < array_length(data); i = i + 1) {
    print array_get(data, i);
}
// Output:
//   row1
//   row2
//   row3

print "=== pattern: skip leading zeros ===";
// Real-world use case: strip leading zeros from
// a number represented as an array of digits.
var digits = [0, 0, 0, 1, 2, 3, 4];
var non_zero_start = 0;
for (var i = 0; i < array_length(digits); i = i + 1) {
    if (array_get(digits, i) != 0) {
        non_zero_start = i;
        i = array_length(digits);
    }
}
var stripped = array_drop(digits, non_zero_start);
for (var i = 0; i < array_length(stripped); i = i + 1) {
    print string(array_get(stripped, i));
}
// Output:
//   1
//   2
//   3
//   4

print "=== what this stage teaches ===";
// (a) "Skip the first N pattern" — Stage 52
//     introduces a native that skips the first N
//     elements. The pattern is "if N <= 0, return
//     full; if N >= array length, return empty;
//     otherwise return the elements from index N
//     to the end". The discipline: **handle the
//     skip correctly.**
//
// (b) "array_take and array_drop are complements"
//     — Stage 51 takes the first N; Stage 52
//     drops the first N. They form a natural pair
//     for splitting an array into head and tail.
//
// (c) "Stage 44's push/pop lesson was applied
//     for the 8th consecutive stage" — 0 impl
//     bugs in Stage 52. The new array_drop
//     registration has 1 push and 1 pop,
//     balanced. The function body has 1 push (the
//     result) and 1 pop, balanced. The
//     discipline: **count pushes and pops after
//     every registration AND inside the function
//     body.** Stage 52 is 9th-consec-zero-bug in
//     the new streak.
//
// (d) "Test-bug discipline applied" — 0 test
//     bugs in this turn. All 8 tests passed on
//     the first run. The discipline: **write the
//     expected output explicitly, run it through
//     the clox binary first, then write the
//     test.**
//
// (e) "Example-bug discipline applied" — 0
//     example bugs in this turn. The discipline:
//     **verify the example output against the
//     comments BEFORE commit** (15-occurrence
//     pattern, the worst-class bug).
//
// (f) "Slice operations family has 2 variants" —
//     Stage 51 (array_take) + Stage 52
//     (array_drop). The natural next step is
//     array_take_while (short-circuit) or
//     array_slice (3-arg variant with start, end,
//     step). The discipline: **slice operations
//     are a common idiom (pagination, top-N, head/
//     tail, sub-array extraction).**
//
// (g) "Pagination is now elegant" — Stage 51's
//     example had to inline the skip logic with a
//     loop. With array_drop, pagination is one
//     line: array_take(array_drop(items, start),
//     page_size).
//
// (h) "Type-predicate family is still COMPLETE"
//     — Stages 44-49 added is_array, is_string,
//     is_number, is_bool, is_nil, is_function.
//     The Stage 52 example doesn't use the type
//     predicates directly, but the array_drop
//     native itself uses IS_ARRAY and IS_NUMBER
//     to validate inputs.
