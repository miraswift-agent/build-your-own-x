// Stage 45 example: is-string.lox
// The "is this value a string?" type predicate. The
// shape: 1 arg, 1 return value (a bool). True iff the
// value is a string; false for every other type.
//
// Stage 45 is the next type predicate after Stage 44's
// is_array. The "type predicate" pattern is now
// established with 2 of 5+ natives (is_array, is_string).
// Future stages will add is_number, is_bool, is_nil,
// is_function.
//
// Like typeof, is_string inspects the value's type tag
// directly. The caller doesn't have to compare a string
// to determine string-ness.

print "=== is_string on strings: true ===";
// is_string returns true for strings (empty or
// populated, including strings that look like numbers).
print is_string("");
print is_string("hello");
print is_string("a b c");
print is_string("42");
print is_string("true");
// Output:
//   true
//   true
//   true
//   true
//   true

print "=== is_string on non-strings: false ===";
// is_string returns false for every non-string type.
// Test across all primitive types and at least one
// function (the native clock()).
print is_string(true);
print is_string(false);
print is_string(nil);
print is_string(42);
print is_string(3.14);
print is_string([]);
print is_string([1, 2, 3]);
print is_string(clock);
// Output:
//   false
//   false
//   false
//   false
//   false
//   false
//   false
//   false

print "=== is_string does not coerce ===";
// is_string must NOT coerce. The number 42 is a number,
// not a string (even though the string "42" parses to
// 42, the inverse doesn't hold). The empty array is
// an array, not a string. The alternative (truthy
// coerces) is JS-style but loses type information.
print is_string(42);
print is_string(0);
print is_string([]);
print is_string(false);
print is_string(nil);
// Output:
//   false
//   false
//   false
//   false
//   false

print "=== compose with is_array: exhaustive type check ===";
// Combine is_string with is_array (Stage 44) for a
// complete type dispatch on the most common types.
// The two natives are complementary:
// - is_string(x) is the string predicate
// - is_array(x) is the array predicate (Stage 44)
fun describe(x) {
    if (is_string(x)) { return "string"; }
    if (is_array(x))  { return "array"; }
    return typeof(x);
}
print describe("hello");
print describe([1, 2, 3]);
print describe(42);
print describe(true);
print describe(nil);
// Output:
//   string
//   array
//   number
//   bool
//   nil

print "=== pattern: filter strings from a mixed list ===";
// Real-world use case: a mixed list of values where
// the caller wants to extract just the strings. This
// would normally require a for loop with type
// checking, or a function. Stage 45 makes it
// ergonomic: is_string(x) is the predicate.
var mixed = [1, "two", [3, 4], nil, "five", [6]];
var strings_only = [];
for (var i = 0; i < array_length(mixed); i = i + 1) {
    var item = array_get(mixed, i);
    if (is_string(item)) {
        array_push(strings_only, item);
    }
}
print array_length(strings_only);
print array_get(strings_only, 0);
print array_get(strings_only, 1);
// Output:
//   2
//   two
//   five

print "=== what this stage teaches ===";
// (a) "The type predicate family is now 2-strong:
//     is_array (Stage 44) and is_string (Stage 45).
//     The pattern is established. Future stages will
//     add is_number, is_bool, is_nil, is_function.
//
// (b) "Type predicates don't coerce" — the discipline
//     from Stage 44 carries forward. The number 42 is
//     a number, not a string (even though the string
//     "42" parses to 42, the inverse doesn't hold).
//     The alternative (truthy coerces) is JS-style but
//     loses type information.
//
// (c) "Type predicates compose with array_filter for
//     type-specific operations" — the array_filter
//     pattern from Stage 30 + is_string = "filter
//     strings from a mixed list" in a few lines.
//     Matches the discipline from Stages 30-44 of
//     composing small primitives.
//
// (d) "Bug caught: 0 bugs in Stage 45" — the Stage 44
//     push/pop lesson was applied. The new is_string
//     registration has 1 push and 1 pop, balanced.
//     The discipline: **count pushes and pops** after
//     every registration. The 5-second cost of
//     counting is much less than the cost of a
//     221-test failure. Stage 45 is 2nd-consec-zero-bug
//     in the new streak (Stage 44 was 1st — it broke
//     the 17-streak but shipped clean after the fix).
