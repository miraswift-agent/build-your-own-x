// Stage 32 example: array-reduce.lox
// The natural mirror of Stage 31's array_map. The third
// clox native that invokes user-defined Lox code from C.
// Demonstrates the "reduce a list to a single value" idiom.
// Real-world use cases: sum, product, max, min, string-join,
// building a hash/object from key-value pairs, count-by-
// condition, group-by-key, flatten.

print "=== sum: total of [1..5] ===";
// Reduce with add: 0 + 1 + 2 + 3 + 4 + 5 = 15.
fun add(acc, x) { return acc + x; }
var total = array_reduce([1, 2, 3, 4, 5], add, 0);
print total;  // 15

print "=== product: 1*2*3*4 = 24 ===";
// Reduce with mul: 1 * 1 * 2 * 3 * 4 = 24.
fun mul(acc, x) { return acc * x; }
var p = array_reduce([1, 2, 3, 4], mul, 1);
print p;  // 24

print "=== string concat: join with empty initial ===";
// Reduce with concat: "" + "a" + "b" + "c" = "abc".
fun cat(acc, s) { return acc + s; }
var joined = array_reduce(["a", "b", "c"], cat, "");
print joined;  // abc

print "=== max: find largest of [3, 1, 4, 1, 5, 9, 2, 6] ===";
// Reduce with max-of-two: starts with -inf, picks the larger
// of (acc, x) at each step. clox has no -infinity; use the
// first element as the initial (or a very small number).
var nums = [3, 1, 4, 1, 5, 9, 2, 6];
fun maxOf(a, b) { if (a > b) return a; return b; }
var largest = array_reduce(nums, maxOf, 0);
print largest;  // 9

print "=== min: find smallest of [3, 1, 4, 1, 5, 9, 2, 6] ===";
// Same shape, smaller-of-two. clox has no +infinity; use a
// very large initial.
fun minOf(a, b) { if (a < b) return a; return b; }
var smallest = array_reduce(nums, minOf, 999999);
print smallest;  // 1

print "=== empty input: returns the initial as-is ===";
// Empty array -> reducer is never called -> the initial
// is returned unchanged. (Different from JS's reduce-without-
// initial form, which uses the first element as the initial
// and errors on an empty array. clox's design: always
// require an initial.)
fun add2(acc, x) { return acc + x; }
var nothing = array_reduce([], add2, 42);
print nothing;  // 42

print "=== count-by-condition: count odd numbers ===";
// Reduce with a counter: starts at 0, increments if x is odd.
// The reducer returns the new count, which becomes the new
// accumulator. The final value is the count.
fun isOdd(x) { return x - 2 * number_floor(x / 2) == 1; }
fun countOdd(acc, x) {
    if (isOdd(x)) return acc + 1;
    return acc;
}
var nOdd = array_reduce([1, 2, 3, 4, 5, 6, 7], countOdd, 0);
print nOdd;  // 4

print "=== compose: map then reduce ===";
// Real-world: double every number, then sum.
// Stage 31 (map) + Stage 32 (reduce) composition.
fun dbl(x) { return x * 2; }
var doubled = array_map([1, 2, 3, 4, 5], dbl);
var total2 = array_reduce(doubled, add, 0);
print total2;  // 30 (2+4+6+8+10)

print "=== compose: filter then map then reduce ===";
// Real-world: keep numbers > 2, then double, then sum.
// Stages 30 + 31 + 32 composition.
fun gt2(x) { return x > 2; }
var big = array_filter([1, 2, 3, 4, 5], gt2);
var bigDoubled = array_map(big, dbl);
var total3 = array_reduce(bigDoubled, add, 0);
print total3;  // 24 (6+8+10)

print "=== strict-error contract ===";
// Uncommenting any of the next lines would error at runtime:
//   array_reduce()                         // no arguments
//   array_reduce([1,2,3])                  // no reducer or initial
//   array_reduce([1,2,3], add)             // no initial
//   array_reduce([1,2,3], add, 0, 99)      // too many args
//   array_reduce("not array", add, 0)      // non-array source
//   array_reduce([1,2,3], 42, 0)           // non-function reducer
//   array_reduce([1,2,3], fun(x) { return x; }, 0)  // 1-arg reducer
// The discipline: array_reduce is strict on arg count
// (exactly 3), on the source being an array, on the reducer
// being a 2-arg Lox closure (not a native), and on the
// reducer's arity being exactly 2.
